#!/bin/sh
# Local, bounded, manually invoked one-shot. No automatic service scheduling.
set -eu
umask 077
PATH=/usr/sbin:/usr/bin:/sbin:/bin
STATE=/tmp/cdn-optimizer
LOCK=/tmp/cdn-optimizer.lock
[ "$(id -u)" = 0 ] || { echo "root execution required" >&2; exit 4; }
[ "$#" -eq 1 ] && [ "$1" = "--manual-public-probe-authorized" ] || { echo "separate manual approval required" >&2; exit 2; }
[ ! -L "$STATE" ] || exit 4
if ! mkdir "$LOCK" 2>/dev/null; then
  echo "scan already running or stale lock; manual inspection required" >&2
  exit 3
fi
[ ! -L "$STATE" ] || exit 4
mkdir -m 0700 -p "$STATE"
[ -d "$STATE" ] && [ ! -L "$STATE" ] || exit 4
[ "$(stat -c %u "$STATE")" = 0 ] || { echo "unsafe state ownership" >&2; exit 4; }
chmod 0700 "$STATE"
[ ! -L "$STATE/result.json" ] || exit 4
TMP="$STATE/.result.$"
cleanup() { rm -f "$TMP"; rmdir "$LOCK" 2>/dev/null || :; }
trap cleanup EXIT
trap 'exit 130' HUP INT TERM
enabled="$(uci -q get cdn_optimizer.main.enabled || :)"
allow="$(uci -q get cdn_optimizer.main.allow_public_probe || :)"
[ "$enabled" = 1 ] && [ "$allow" = 1 ] || { echo "probe disabled" >&2; exit 4; }
service="$(uci -q get cdn_optimizer.main.service || :)"
candidate="$(uci -q get cdn_optimizer.main.candidate_ip || :)"
bytes="$(uci -q get cdn_optimizer.main.max_bytes || :)"
case "$service" in github|x|twitch) ;; *) exit 5;; esac
case "$bytes" in ''|*[!0-9]*) exit 5;; esac
[ "$bytes" -ge 1 ] && [ "$bytes" -le 65536 ] || exit 5
# CLI validates IPv4 eligibility and TLS hostname; redirect and bytes bounded.
if /usr/bin/fastly-public-health --service "$service" --ip "$candidate" --bytes "$bytes" --public-probe-required > "$TMP"; then
  # Only a verified, bounded successful report may be published.
  [ -s "$TMP" ] && [ "$(wc -c < "$TMP")" -le 16384 ] || { rm -f "$STATE/result.json"; exit 6; }
  chmod 0600 "$TMP"
  mv -f "$TMP" "$STATE/result.json"
else
  # A failed probe must never leave stale success evidence.
  rm -f "$STATE/result.json"
  exit 6
fi

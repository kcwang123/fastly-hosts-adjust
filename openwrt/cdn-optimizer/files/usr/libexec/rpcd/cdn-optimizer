#!/bin/sh
# rpcd exec interface: read-only diagnostic status, no scan action.
set -eu
case "${1:-}" in
 list) printf '%s\n' '{"status":{}}' ;;
 call)
   [ "${2:-}" = status ] || exit 2
   if [ -r /tmp/cdn-optimizer/result.json ] && [ ! -L /tmp/cdn-optimizer/result.json ]; then
     cat /tmp/cdn-optimizer/result.json
   else
     printf '%s\n' '{"schema_version":1,"status":"not_tested","safe_to_apply":false}'
   fi ;;
 *) exit 2;;
esac

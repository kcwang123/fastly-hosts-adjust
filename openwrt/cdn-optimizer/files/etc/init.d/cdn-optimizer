#!/bin/sh /etc/rc.common
USE_PROCD=1
START=95
STOP=10
PROG=/usr/bin/fastly-public-health

start_service() {
  local enabled
  config_load cdn_optimizer
  config_get_bool enabled main enabled 0
  [ "$enabled" = 1 ] || return 0
  # Service does not launch scans automatically. Explicit CLI/probe gate only.
  procd_open_instance
  procd_set_param command /bin/sleep 2147483647
  procd_set_param respawn 0 0 0
  procd_close_instance
}
